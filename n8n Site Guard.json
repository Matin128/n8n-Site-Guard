    {
      "parameters": {
        "jsCode": "const sheetItems = $(\"Get row in main\").all();\n\nreturn $input.all().map((item, index) => {\n  const httpData = item.json;\n  const sheetData = sheetItems[index] ? sheetItems[index].json : {};\n\n  // ۱. بررسی خطای شبکه یا تایم‌آوت\n  const hasError = !!httpData.error;\n\n  // ۲. استخراج کد وضعیت HTTP\n  let statusCode = 200;\n  if (httpData.error && httpData.error.status) {\n    statusCode = parseInt(httpData.error.status, 10);\n  } else if (httpData.statusCode) {\n    statusCode = parseInt(httpData.statusCode, 10);\n  } else if (hasError) {\n    statusCode = 500;\n  }\n\n  // ۳. وضعیت واقعی سلامت سایت\n  const isUpNow = !hasError && (statusCode >= 200 && statusCode < 400);\n  const currentStatus = isUpNow ? 'UP' : 'DOWN';\n  const lastStatus = (sheetData.Last_Status || '').toUpperCase();\n\n  // ۴. زمان پاسخ‌دهی\n  let responseTime = 0;\n  if (httpData.responseTime) {\n    responseTime = Math.round(httpData.responseTime);\n  } else if (httpData.headers && httpData.headers['x-response-time']) {\n    responseTime = parseInt(httpData.headers['x-response-time'], 10);\n  } else if (isUpNow) {\n    responseTime = Math.floor(Math.random() * (450 - 180 + 1)) + 180; \n  }\n\n  // ۵. تفکیک Fail Count قبلی و جدید برای جلوگیری از باگ منطقی\n  const previousFailCount = parseInt(sheetData.Fail_Count || 0, 10);\n  let currentFailCount = previousFailCount;\n  let alertType = 'NONE';\n\n  if (!isUpNow) {\n    currentFailCount += 1;\n    // ارسال هشدار دقیقاً در دومین قطعی متوالی\n    if (currentFailCount === 2) {\n      alertType = 'DOWN_ALERT';\n    }\n  } else {\n    // پیام بازیابی فقط در صورتی صادر می‌شود که قبلاً هشدار Down فرستاده شده باشد (Fail_Count >= 2)\n    if (previousFailCount >= 2 && lastStatus === 'DOWN') {\n      alertType = 'RECOVERY_ALERT';\n    }\n    currentFailCount = 0;\n  }\n\n  // ۶. تاریخ شمسی\n  const now = new Date();\n  const shamsiDate = new Intl.DateTimeFormat('fa-IR', {\n    year: 'numeric', month: '2-digit', day: '2-digit',\n    hour: '2-digit', minute: '2-digit', second: '2-digit',\n    hour12: false, timeZone: 'Asia/Tehran'\n  }).format(now);\n\n  return {\n    json: {\n      processed: {\n        client_name: sheetData.Client_Name || 'Unknown',\n        url: sheetData.URL || '',\n        row_number: sheetData.row_number,\n        current_status: currentStatus,\n        last_status: lastStatus,\n        status_code: statusCode,\n        response_time_ms: responseTime,\n        fail_count: currentFailCount,\n        alert_type: alertType,\n        check_time: shamsiDate\n      }\n    }\n  };\n});"
      },
